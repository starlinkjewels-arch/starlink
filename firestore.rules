rules_version = '2';

// Starlink Jewels — Firestore security rules
//
// Model:
//   * Website content is public to read, editable only by admins.
//   * An "admin" is a signed-in Firebase Auth user who also has a document at
//     admins/{uid}. Create that document by hand in the Firebase console
//     (Firestore → admins → Document ID = the user's UID from Authentication).
//   * After accepting analytics cookies, a visitor's browser creates one record
//     per day in /visitors (fixed shape) and updates only its browsing fields;
//     cookie choices are logged in /consents. Only admins can read or delete them.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---- Admin allowlist -------------------------------------------------
    // Managed only from the Firebase console; an admin can read their own entry.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- Public website content -----------------------------------------
    // Read by every visitor (and by the sitemap GitHub Action), written from
    // the admin panel only.
    match /banners/{docId}             { allow read: if true; allow write: if isAdmin(); }
    match /categories/{docId}          { allow read: if true; allow write: if isAdmin(); }
    match /products/{docId}            { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{docId}             { allow read: if true; allow write: if isAdmin(); }
    match /featured-collection/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /contact/{docId}             { allow read: if true; allow write: if isAdmin(); }
    match /offices/{docId}             { allow read: if true; allow write: if isAdmin(); }
    match /blogs/{docId}               { allow read: if true; allow write: if isAdmin(); }
    match /videos/{docId}              { allow read: if true; allow write: if isAdmin(); }
    match /promo-header/{docId}        { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{docId}        { allow read: if true; allow write: if isAdmin(); }

    // The site loads all guides and hides drafts in the browser, so reads must
    // stay public (a "published only" rule would reject that query outright).
    match /buying-guides/{docId}       { allow read: if true; allow write: if isAdmin(); }

    // Popup ad shown on the public site (Admin → Popup Ad).
    match /ads/{docId}                 { allow read: if true; allow write: if isAdmin(); }

    // ---- Visitor analytics (only written after cookie consent) ----------
    // One record per browser per day, created by src/lib/analytics.ts and then
    // updated as the visitor browses (pages, products viewed, WhatsApp clicks).
    match /visitors/{docId} {
      allow read, delete: if isAdmin();
      allow create: if isValidVisitorLog(request.resource.data);
      allow update: if isValidVisitUpdate(request.resource.data, resource.data);
    }

    // Consent log from the cookie banner (proof of consent): the choice, the button used,
    // the consent id and the device/browser type. visitorId is only sent when analytics was
    // accepted and links the entry to that browser's /visitors records.
    match /consents/{docId} {
      allow read, delete: if isAdmin();
      allow update: if false;
      allow create: if isValidConsent(request.resource.data);
    }

    function isValidConsent(d) {
      return d.keys().hasOnly([
          'analytics', 'marketing', 'version', 'page', 'timestamp',
          'action', 'consentId', 'visitorId', 'browser', 'device', 'os', 'language', 'timezone'
        ])
        && d.analytics is bool
        && d.marketing is bool
        && d.version is string && d.version.size() <= 20
        && d.page is string && d.page.size() <= 300
        && d.timestamp == request.time
        && (!('action' in d) || d.action in ['accept_all', 'reject_all', 'custom'])
        && (!('consentId' in d) || (d.consentId is string && d.consentId.size() <= 40))
        && (!('visitorId' in d) || (d.analytics == true && d.visitorId is string && d.visitorId.size() <= 40))
        && (!('browser' in d) || (d.browser is string && d.browser.size() <= 30))
        && (!('device' in d) || (d.device is string && d.device.size() <= 20))
        && (!('os' in d) || (d.os is string && d.os.size() <= 20))
        && (!('language' in d) || d.language == null || (d.language is string && d.language.size() <= 20))
        && (!('timezone' in d) || d.timezone == null || (d.timezone is string && d.timezone.size() <= 60));
    }

    // ---- Quote / consultation requests (website forms → Admin → Leads) ----
    match /leads/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if isValidLead(request.resource.data);
    }

    function isValidLead(d) {
      return d.keys().hasOnly([
          'type', 'name', 'email', 'phone', 'country', 'city', 'contactMethod', 'preferredTime',
          'message', 'status', 'page', 'referrer', 'createdAt', 'productId', 'productName', 'productUrl'
        ])
        && d.keys().hasAll(['type', 'name', 'email', 'country', 'contactMethod', 'status', 'createdAt'])
        && d.status == 'new'
        && d.createdAt == request.time
        && d.type is string && d.type.size() <= 40
        && d.contactMethod is string && d.contactMethod.size() <= 20
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.email is string && d.email.size() <= 120 && d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && d.country is string && d.country.size() > 0 && d.country.size() <= 60
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 40))
        && (!('city' in d) || (d.city is string && d.city.size() <= 80))
        && (!('preferredTime' in d) || (d.preferredTime is string && d.preferredTime.size() <= 40))
        && (!('message' in d) || (d.message is string && d.message.size() <= 2000))
        && (!('page' in d) || (d.page is string && d.page.size() <= 300))
        && (!('referrer' in d) || d.referrer == null || (d.referrer is string && d.referrer.size() <= 300))
        && (!('productId' in d) || (d.productId is string && d.productId.size() <= 60))
        && (!('productName' in d) || (d.productName is string && d.productName.size() <= 160))
        && (!('productUrl' in d) || (d.productUrl is string && d.productUrl.size() <= 300));
    }

    // ---- Product reviews (moderated in Admin → Reviews) ----
    // Anyone may submit a pending, unverified review; only approved ones are public.
    match /reviews/{docId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow update, delete: if isAdmin();
      allow create: if isValidReview(request.resource.data);
    }

    function isValidReview(d) {
      return d.keys().hasOnly(['productId', 'productName', 'rating', 'title', 'text', 'name', 'email', 'country', 'status', 'verified', 'createdAt'])
        && d.keys().hasAll(['productId', 'rating', 'text', 'name', 'email', 'status', 'verified', 'createdAt'])
        && d.status == 'pending'
        && d.verified == false
        && d.createdAt == request.time
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.productId is string && d.productId.size() > 0 && d.productId.size() <= 60
        && (!('productName' in d) || (d.productName is string && d.productName.size() <= 160))
        && (!('title' in d) || (d.title is string && d.title.size() <= 100))
        && d.text is string && d.text.size() >= 10 && d.text.size() <= 2000
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.email is string && d.email.size() <= 120 && d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && (!('country' in d) || (d.country is string && d.country.size() <= 60));
    }

    // Only the browsing fields may change, arrays stay bounded, counters only go up.
    function isValidVisitUpdate(d, old) {
      return d.diff(old).affectedKeys().hasOnly(['pages', 'pageviews', 'products', 'whatsappClicks', 'lastSeen'])
        && d.lastSeen == request.time
        && (!('pages' in d) || (d.pages is list && d.pages.size() <= 60))
        && (!('products' in d) || (d.products is list && d.products.size() <= 60))
        && (!('pageviews' in d) || (d.pageviews is int && d.pageviews <= 1000))
        && (!('whatsappClicks' in d) || (d.whatsappClicks is int && d.whatsappClicks <= 200));
    }

    // Mirrors the record built in src/lib/analytics.ts. Anything else is rejected,
    // so the public endpoint can't be used to store arbitrary data.
    function isValidVisitorLog(d) {
      return d.keys().hasOnly([
          'hostname', 'origin', 'referrer',
          'ip', 'country', 'region', 'city', 'postal', 'timezone',
          'userAgent', 'browser', 'device', 'os', 'language', 'screen',
          'visitorId', 'consentId', 'consentMarketing', 'org', 'utmSource', 'utmMedium', 'utmCampaign',
          'page', 'pages', 'pageviews', 'products', 'whatsappClicks',
          'timestamp', 'lastSeen', 'grantedLocation',
          'latitude', 'longitude', 'accuracy'
        ])
        && d.keys().hasAll(['page', 'timestamp', 'grantedLocation', 'userAgent'])
        && (!('lastSeen' in d) || d.lastSeen == request.time)
        && (!('pages' in d) || (d.pages is list && d.pages.size() <= 60))
        && (!('products' in d) || (d.products is list && d.products.size() <= 60))
        && (!('visitorId' in d) || (d.visitorId is string && d.visitorId.size() <= 40))
        && (!('consentId' in d) || d.consentId == null || (d.consentId is string && d.consentId.size() <= 40))
        && (!('org' in d) || d.org == null || (d.org is string && d.org.size() <= 120))
        && d.timestamp == request.time
        && d.grantedLocation is bool
        && d.page is string && d.page.size() <= 500
        && d.userAgent is string && d.userAgent.size() <= 1000
        && (!('hostname' in d) || (d.hostname is string && d.hostname.size() <= 255))
        && (!('origin' in d) || (d.origin is string && d.origin.size() <= 255))
        && (!('referrer' in d) || d.referrer == null || (d.referrer is string && d.referrer.size() <= 2000))
        && (!('ip' in d) || (d.ip is string && d.ip.size() <= 64))
        && (!('latitude' in d) || d.latitude is number)
        && (!('longitude' in d) || d.longitude is number)
        && (!('accuracy' in d) || d.accuracy is number);
    }

    // ---- Everything else --------------------------------------------------
    // Collections not listed above are closed by default.
  }
}
